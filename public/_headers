# HTML & Service routes must come first so Cloudflare Pages does NOT override hashed /assets/* caching
/*
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Pragma: no-cache
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Pragma: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Pragma: no-cache

# API responses (if proxied through Cloudflare Workers / Origin) must never be cached at edge
/api/*
  Cache-Control: private, no-store, no-cache, must-revalidate, proxy-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Pragma: no-cache
  Expires: 0

# Hashed Vite static assets are safe to cache long-term
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static icons and images
/icons/*
  Cache-Control: public, max-age=2592000
