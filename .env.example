# GEMINI_API_KEY: Required for Gemini AI API calls on the backend server.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Optional client-side Gemini API key for static/standalone deployments (e.g. Netlify/Vercel).
# When set, the frontend calls the Gemini API directly (gemini-1.5-flash) without requiring a backend server.
# If omitted or left empty, the application automatically falls back to backend routes (/api/ai/...) for Blitz/Docker containers.
VITE_GEMINI_API_KEY=""


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL: Optional custom Supabase URL (defaults to configured instance)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Optional custom Supabase anonymous key
VITE_SUPABASE_ANON_KEY=""

# TEACHER_PASSWORD: Password for teacher dashboard authentication
TEACHER_PASSWORD="1234"

# PRINCIPAL_PASSWORD: Password for principal dashboard authentication
PRINCIPAL_PASSWORD="khalili100"
