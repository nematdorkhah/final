# GEMINI_API_KEY: Required for Gemini AI API calls on the backend server (server.ts).
# NEVER expose this key with a VITE_ prefix or in frontend code.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL: Optional custom Supabase URL (defaults to configured instance)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Optional custom Supabase anonymous/publishable key
VITE_SUPABASE_ANON_KEY=""

# VITE_API_BASE_URL: Backend or Cloudflare Worker origin (e.g. https://class.nemat-darkhah.workers.dev)
# Allows static Netlify builds to call /api/ai/* securely without exposing GEMINI_API_KEY in frontend bundles.
VITE_API_BASE_URL=""

# TEACHER_PASSWORD: Password for teacher dashboard authentication
TEACHER_PASSWORD="1234"

# PRINCIPAL_PASSWORD: Password for principal dashboard authentication
PRINCIPAL_PASSWORD="khalili100"
